# Ubuntu 22.04 + CUDA 12.8 (RTX 5070 / Blackwell) + ROS 2 Humble + Gazebo Classic (Gazebo 11)
# Requires NVIDIA Container Toolkit on the host: https://docs.nvidia.com/datacenter/cloud-native/container-toolkit/install-guide.html
FROM nvidia/cuda:12.8.1-base-ubuntu22.04

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# NVIDIA runtime capabilities for GPU rendering
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=all
ENV __GLX_VENDOR_LIBRARY_NAME=nvidia
ENV __NV_PRIME_RENDER_OFFLOAD=1
ENV QT_X11_NO_MITSHM=1
ENV SDL_AUDIODRIVER=dummy

# Install locales and set UTF-8
RUN apt-get update && apt-get install -y \
    locales \
    && locale-gen en_US en_US.UTF-8 \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8

# Install prerequisites
RUN apt-get update && apt-get install -y \
    curl \
    gnupg2 \
    lsb-release \
    software-properties-common \
    # Use GLVND dispatch libraries and let the NVIDIA runtime provide the vendor GL driver
    libgl1 \
    libglx0 \
    libegl1 \
    libglu1-mesa \
    mesa-utils \
    && rm -rf /var/lib/apt/lists/*

# Add ROS 2 apt repository
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
    -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
    http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" \
    > /etc/apt/sources.list.d/ros2.list

# Install ROS 2 Humble Desktop
RUN apt-get update && apt-get install -y \
    ros-humble-desktop \
    python3-rosdep \
    python3-colcon-common-extensions \
    python3-argcomplete \
    && rm -rf /var/lib/apt/lists/*

# Bootstrap rosdep
RUN rosdep init && rosdep update

# Source ROS 2 automatically for every shell session
RUN echo "source /opt/ros/humble/setup.bash" >> /root/.bashrc

# Ensure GUI tools have a writable config path by default
ENV XDG_CONFIG_HOME=/root/.config
RUN mkdir -p /root/.config

# Installing Extra dependencies for ROS 2 packages
RUN apt-get update && apt-get install -y \
    python3-pip \
    ros-humble-ros2-control \
    ros-humble-ros2-controllers \
    ros-humble-xacro \
    ros-humble-ros-gz* \
    ros-humble-*-ros2-control \
    ros-humble-joint-state-publisher-gui \
    ros-humble-turtlesim \
    ros-humble-robot-localization \
    ros-humble-joy \
    ros-humble-joy-teleop \
    ros-humble-tf-transformations \
    jstest-gtk \
    ros-humble-plotjuggler-ros \
    libcanberra-gtk-module \
    libcanberra-gtk3-module \
    libserial-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install transforms3d

RUN apt-get update && apt-get install -y \
    ros-humble-twist-mux* \
    ros-humble-key-teleop \
    && rm -rf /var/lib/apt/lists/*

# Set up workspace directory
WORKDIR /ros2_ws

# Copy the ROS2 directory from the repository into the container
COPY ROS2 /ros2_ws/ROS2

# Set up workspace directory - Change it depending on the course
WORKDIR /ros2_ws/ROS2/MapandLocalization

RUN /bin/bash -c "source /opt/ros/humble/setup.bash && colcon build"

CMD ["/bin/bash"]
